{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/win-bash-hook.js\" session-start",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\win-bash-hook.js\" session-start",
            "timeout": 5,
            "statusMessage": "(win-bash) Resolving Niubash Bash"
          }
        ]
      }
    ]
  }
}
