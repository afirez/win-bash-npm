{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(exec_command|functions\\.exec_command|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const{spawnSync}=require('child_process');const s=process.argv[1];const p=s.startsWith('\\\\\\\\?\\\\')?s.slice(4):s;spawnSync(process.execPath,[p,...process.argv.slice(2)],{stdio:'inherit'})\" \"${PLUGIN_ROOT}/scripts/win-bash-hook.js\" pre-tool-use",
            "commandWindows": "node -e \"const{spawnSync}=require('child_process');const s=process.argv[1];const p=s.startsWith('\\\\\\\\?\\\\')?s.slice(4):s;spawnSync(process.execPath,[p,...process.argv.slice(2)],{stdio:'inherit'})\" \"${PLUGIN_ROOT}\\scripts/win-bash-hook.js\" pre-tool-use",
            "timeout": 5,
            "statusMessage": "(win-bash) Injecting Niubash Bash shell"
          }
        ]
      }
    ]
  }
}
