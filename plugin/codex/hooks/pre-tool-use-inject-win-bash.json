{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(exec_command|functions\\.exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/win-bash-hook.js\" pre-tool-use",
            "commandWindows": "node \"${PLUGIN_ROOT}\\scripts\\win-bash-hook.js\" pre-tool-use",
            "timeout": 5,
            "statusMessage": "(win-bash) Injecting Niubash Bash shell"
          }
        ]
      }
    ]
  }
}
